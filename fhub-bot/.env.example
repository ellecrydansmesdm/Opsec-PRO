# ==========================================
# 🤖 FHUB CORE BOT — CONFIGURATION (.env)
# ==========================================

# Token du bot Discord (depuis Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Identifiant du Bot (Developer Portal > General Information > Application ID)
CLIENT_ID=

# Identifiant de ton serveur Discord (Clic droit sur le serveur > Copier l'identifiant)
GUILD_ID=1341071221160378368

# ID du rôle attribué automatiquement quand un membre accepte le règlement
MEMBER_ROLE_ID=

# ID du rôle attribué aux clients Opsec PRO
CUSTOMER_ROLE_ID=

# ID du rôle Staff / Modérateur ayant accès aux tickets
STAFF_ROLE_ID=

# ID de la catégorie où seront créés les tickets
TICKET_CATEGORY_ID=

# ID du salon où seront envoyés les logs de tickets et de modération
LOGS_CHANNEL_ID=

# ID du salon Règlement (où sera envoyé le message de validation)
RULES_CHANNEL_ID=

# ID du salon Tickets (où sera envoyé le panel d'ouverture de tickets)
TICKETS_PANEL_CHANNEL_ID=
